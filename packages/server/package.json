{
  "name": "@staffroom/server",
  "version": "0.0.1",
  "description": "Staffroom server: HTTP and WebSocket host for the office.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node scripts/copy-web.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/staffroom-ai/staffroom.git",
    "directory": "packages/server"
  },
  "dependencies": {
    "@staffroom/core": "workspace:*",
    "chokidar": "^5.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@staffroom/templates": "workspace:*",
    "@staffroom/web": "workspace:*",
    "@types/node": "^26.5.1",
    "@types/ws": "^8.18.1",
    "zod": "^4.6.5"
  }
}
