{
  "name": "@staffroom/templates",
  "version": "0.0.1",
  "description": "Staffroom office templates: studio, agency, ecommerce, clinic, consultant.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "studio",
    "agency",
    "ecommerce",
    "clinic",
    "consultant",
    "tools",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/staffroom-ai/staffroom.git",
    "directory": "packages/templates"
  },
  "devDependencies": {
    "@staffroom/core": "workspace:*",
    "@types/node": "^26.5.1",
    "gray-matter": "^4.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
