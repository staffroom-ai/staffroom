{
  "name": "@staffroom/core",
  "version": "0.0.1",
  "description": "Staffroom core: agent runtime, provider adapters, tool registry, brain index.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/testing/index.ts --format esm --dts --clean --external vitest",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/staffroom-ai/staffroom.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "ollama": "^0.6.3",
    "openai": "^7.15.0",
    "picomatch": "^4.0.7",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/picomatch": "^4.0.3"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
