{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "globalPassThroughEnv": ["CHANGESET_BASE", "CI", "GITHUB_BASE_REF"]
}
